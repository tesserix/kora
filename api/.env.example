PORT=8080
ENV=development
DATABASE_URL=postgres://kora:kora_dev@localhost:5432/kora?sslmode=disable
REDIS_URL=redis://localhost:6379/0
FIREBASE_PROJECT_ID=kora-app
AI_GATEWAY_ENABLED=true
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=kora-auto
# Weekly OpenFoodFacts delta refresh (0 disables; see internal/nutrition/refresh)
FOOD_REFRESH_EVERY=168h

# The Tesserix platform console's shared HMAC secret. Empty leaves
# /v1/admin/{audit-logs,inbox,entities,health,kpis} unmounted, which is a
# valid local setup. A DIFFERENT key from KORA_BFF_HMAC_KEY, and a raw string
# rather than base64 — see internal/platformauth and docs/admin-contract.md.
KORA_PLATFORM_ADMIN_SECRET=

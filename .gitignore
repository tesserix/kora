# env & secrets
.env
.env.*
!.env.example
*-service-account*.json
google-services.json
GoogleService-Info.plist

# ...except the mobile app's, which EAS Build needs present at build time.
# Unlike a service-account key, an iOS GoogleService-Info.plist is public by
# design: it is embedded in every copy of the shipped binary, and its API_KEY
# is a client identifier restricted by bundle ID, not a credential. Keeping it
# untracked makes it an invisible build input — the cloud builder never sees it
# and the build fails for a reason nothing in the repo explains.
!apps/mobile/GoogleService-Info.plist

# Go
api/bin/
api/coverage.out

# Node / Expo
node_modules/
.expo/
dist/
*.tsbuildinfo

# Screenshot harness output (apps/mobile/scripts/shots.mjs). Captured images
# are never committed: goldens before the noise floor is known produce a suite
# that fails randomly, gets muted, and then hides the next bug (kora#257).
.shots/

# OS / editor
.DS_Store
.idea/

# Brainstorming visual companion artifacts
.superpowers/brainstorm/
.superpowers/

# Local EAS build artifacts. `eas build --local` drops the .ipa in apps/mobile,
# and a 25 MB binary was swept into db7cc25 by a `git add -A`.
*.ipa
*.app.zip

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Local agent tooling: `.ignore` re-admits graft's cache to ripgrep, and
# .agents/ holds per-machine skill scaffolding. Neither belongs to the build.
.ignore
.agents/

# Sign-in is Zitadel hosted login (src/auth/session.ts). None of these is a
# secret: they are the Kora project and its two native OIDC clients, from the
# identity-operator claims in tesserix-k8s (k8s/operators/zitadel/claims/
# kora.yaml; status.projectId and status.clientId). The project id MUST match
# kora-api's ZITADEL_PROJECT_ID, which pins the token audience: a mismatch makes
# every authenticated request 401 with no way for the client to tell why.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_ZITADEL_ISSUER=https://auth.tesserix.app
EXPO_PUBLIC_ZITADEL_PROJECT_ID=394926080202442797
EXPO_PUBLIC_ZITADEL_CLIENT_ID_IOS=394926081745881133
EXPO_PUBLIC_ZITADEL_CLIENT_ID_ANDROID=394926084329572397

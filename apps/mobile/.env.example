# The Firebase project below MUST match kora-api's FIREBASE_PROJECT_ID
# (tesserix-k8s: charts/apps/kora-api/values.yaml). The API verifies the `aud`
# claim against it, so a mismatch makes every authenticated request 401 with no
# way for the client to tell why.
#
# kora-app-e6d38 is Kora's own Firebase project; its "kora-mobile" web app is
# what these values come from. Copy them from Firebase Console > Project
# settings > Your apps > kora-mobile > SDK setup and configuration.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=kora-app-e6d38.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=kora-app-e6d38
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google Sign-In OAuth clients, both from the same kora-app-e6d38 project.
# WEB is the client Firebase's Google provider is configured with, and is what
# GoogleSignin.configure() wants as `webClientId` — NOT the iOS one, despite
# this being an iOS app. IOS is the native client whose reversed form is the
# `iosUrlScheme` in app.json's google-signin plugin block; the two must agree or
# sign-in fails with an opaque DEVELOPER_ERROR.
# GCP Console > APIs & Services > Credentials, project kora-app-e6d38.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

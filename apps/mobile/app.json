{
  "expo": {
    "name": "Kora",
    "slug": "kora",
    "owner": "tesserix-org",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "mobile",
      "com.tesserix.kora"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tesserix.kora",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.security.application-groups": [
          "group.com.tesserix.kora"
        ]
      },
      "appleTeamId": "2CRHRRYBPL"
    },
    "android": {
      "package": "com.tesserix.kora",
      "adaptiveIcon": {
        "backgroundColor": "#0A0D0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_EXERCISE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0D0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kora uses your photos to identify meals you log."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kora uses the camera to photograph and scan the foods you log."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Kora uses the microphone so you can describe meals by voice.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Kora reads your steps and sleep to show real activity alongside your nutrition."
        }
      ],
      "@react-native-community/datetimepicker",
      "@bacons/apple-targets",
      "expo-asset",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "tesserix",
          "project": "kora"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthConnectQueries"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd0c0d4b-33c3-4d8e-8571-beaf5d9b798e"
      }
    }
  }
}
